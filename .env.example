# k8n Environment Configuration
# Copy this file to .env and update values as needed
# Used by both development (npm run dev) and production (docker-compose)

# ============================================
# Database Configuration
# ============================================
DATABASE_URL=postgres://k8n:k8npassword@localhost:5432/k8n_db?sslmode=disable
POSTGRES_PASSWORD=k8npassword

# ============================================
# API Configuration
# ============================================
API_PORT=8080

# ============================================
# Frontend Configuration
# ============================================
# Leave EMPTY. Next.js proxies /api/* to the Go backend (see next.config.ts),
# so the browser makes same-origin requests and CORS never comes into play.
# Only set this when the API lives on a different host than the frontend.
NEXT_PUBLIC_API_URL=

# Where the Next.js server forwards /api/* to.
API_BACKEND_URL=http://localhost:8080

# ============================================
# AI Features (optional)
# ============================================
# Without a key, every AI surface is hidden and the rest of k8n works normally.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ============================================
# MCP — k8n as a server
# ============================================
# When true, the MCP server k8n exposes offers read-only tools only (no apply,
# no delete). Recommended for anything reachable beyond localhost.
K8N_MCP_READONLY=false

# ============================================
# MCP — k8n as a client (optional)
# ============================================
# Point k8n at MCP servers you already run and their tools become available to
# the assistant alongside k8n's own. Either a path to a JSON file or the JSON
# itself, in the same shape every other MCP client uses:
#
#   {
#     "mcpServers": {
#       "docs":    { "command": "npx", "args": ["-y", "@acme/docs-mcp"] },
#       "grafana": { "url": "http://localhost:9000/mcp" }
#     }
#   }
#
# A server that fails to start is reported and skipped, never fatal.
# K8N_MCP_SERVERS=./mcp-servers.json

# ============================================
# Production Deployment
# ============================================
# Port to expose k8n on (default: 80)
# K8N_PORT=80

# Path to your kubeconfig directory on the host machine
# KUBECONFIG_PATH=~/.kube

# Allowed CORS origins (comma-separated)
# ALLOWED_ORIGINS=http://localhost,https://k8n.yourdomain.com

# ============================================
# Optional: Development Settings
# ============================================
# KUBECONFIG=/path/to/your/kubeconfig
# LOG_LEVEL=debug
# ENABLE_CORS=true
